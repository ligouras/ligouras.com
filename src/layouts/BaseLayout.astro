---
// Self-hosted static weights: no third-party request before first paint.
import "@fontsource/archivo/600.css";
import "@fontsource/archivo/700.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";

interface Props {
  title: string;
  description: string;
  url: string;
  /** Social preview image (1200×630), path relative to the site root. */
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  url,
  image = "/og.jpg",
  imageAlt = "Spyros Ligouras — Senior Cloud & Software Engineer",
} = Astro.props;
const imageUrl = new URL(image, Astro.site ?? url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>L</text></svg>"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #09090b;
    --surface: #111114;
    --surface-elevated: #18181b;
    --fg: #fafafa;
    --fg-secondary: #d4d4d8;
    --muted: #a1a1aa;
    /* ≥ 4.5:1 on --bg and --surface (was #71717a, ~3.9:1). */
    --subtle: #8b8b94;
    --border: #27272a;
    --accent: #2563eb;
    --accent-hover: #3b82f6;
    --accent-glow: rgba(37, 99, 235, 0.16);
    --radius: 12px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    color-scheme: dark;
    background-color: var(--bg);
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    min-height: 100dvh;
    background-color: var(--bg);
    background-image: radial-gradient(
      65% 50% at 50% 0%,
      var(--accent-glow) 0%,
      transparent 70%
    );
    background-repeat: no-repeat;
    color: var(--fg);
    font-family: "Space Grotesk", system-ui, -apple-system, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
