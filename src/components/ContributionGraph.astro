---
import type { ContributionSummary } from "../lib/github-contributions";

interface Props {
  data: ContributionSummary;
}

const { data } = Astro.props;
const weekCount = data.weeks.length;

function formatDayLabel(dateStr: string, count: number): string {
  const date = new Date(`${dateStr}T00:00:00Z`);
  const formatted = date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });
  if (count === 0) return `No contributions on ${formatted}`;
  if (count === 1) return `1 contribution on ${formatted}`;
  return `${count.toLocaleString("en-US")} contributions on ${formatted}`;
}
---

<section class="activity-card" aria-labelledby="activity-heading">
  <div class="activity-header">
    <div>
      <h2 id="activity-heading">GitHub Activity</h2>
      <p class="activity-subtitle">
        {
          data.source === "fallback"
            ? "Activity feed unavailable offline"
            : `${data.totalContributions.toLocaleString("en-US")} contributions in the last year`
        }
      </p>
    </div>
    <a
      class="profile-link"
      href={`https://github.com/${data.username}`}
      target="_blank"
      rel="me noopener"
    >
      @{data.username}
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="stats-row">
    <div class="stat">
      <span class="stat-value">{data.totalContributions.toLocaleString("en-US")}</span>
      <span class="stat-label">Contributions</span>
    </div>
    <div class="stat">
      <span class="stat-value">{data.activeDays}</span>
      <span class="stat-label">Active days</span>
    </div>
    <div class="stat">
      <span class="stat-value">{data.currentStreak}d</span>
      <span class="stat-label">Current streak</span>
    </div>
    <div class="stat">
      <span class="stat-value">{data.longestStreak}d</span>
      <span class="stat-label">Longest streak</span>
    </div>
  </div>

  <div class="graph-scroll" tabindex="0" aria-label="GitHub contribution heatmap">
    <div class="graph-inner" style={`--weeks: ${weekCount};`}>
      <div class="months-row" aria-hidden="true">
        <div class="day-spacer"></div>
        <div class="months-track">
          {
            data.monthLabels.map((m) => (
              <span class="month-label" style={`grid-column-start: ${m.weekIndex + 1};`}>
                {m.label}
              </span>
            ))
          }
        </div>
      </div>

      <div class="grid-body">
        <div class="day-labels" aria-hidden="true">
          <span></span>
          <span>Mon</span>
          <span></span>
          <span>Wed</span>
          <span></span>
          <span>Fri</span>
          <span></span>
        </div>

        <div class="weeks-grid" role="grid" aria-label="Daily contributions over the past year">
          {
            data.weeks.map((week) => (
              <div class="week-col" role="row">
                {week.days.map((day) =>
                  day ? (
                    <span
                      class="cell"
                      role="gridcell"
                      tabindex="0"
                      data-level={day.level}
                      data-tip={formatDayLabel(day.date, day.count)}
                      aria-label={formatDayLabel(day.date, day.count)}
                    />
                  ) : (
                    <span class="cell empty" aria-hidden="true" />
                  ),
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="graph-footer">
    <p class="inspect-readout" id="contrib-readout" aria-live="polite">
      Hover or focus a day to inspect
    </p>
    <div class="legend" aria-hidden="true">
      <span>Less</span>
      <span class="cell" data-level="0"></span>
      <span class="cell" data-level="1"></span>
      <span class="cell" data-level="2"></span>
      <span class="cell" data-level="3"></span>
      <span class="cell" data-level="4"></span>
      <span>More</span>
    </div>
  </div>
</section>

<script>
  const readout = document.getElementById("contrib-readout");
  const defaultMsg = "Hover or focus a day to inspect";
  const grid = document.querySelector(".weeks-grid");

  if (readout && grid) {
    const showTip = (target: EventTarget | null) => {
      if (!(target instanceof HTMLElement)) return;
      const tip = target.dataset.tip;
      if (tip) readout.textContent = tip;
    };

    const resetTip = () => {
      readout.textContent = defaultMsg;
    };

    grid.addEventListener("pointerover", (e) => showTip(e.target));
    grid.addEventListener("focusin", (e) => showTip(e.target));
    grid.addEventListener("pointerleave", resetTip);
    grid.addEventListener("focusout", (e) => {
      if (!grid.contains(e.relatedTarget as Node | null)) {
        resetTip();
      }
    });
  }
</script>

<style>
  .activity-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
  }

  .activity-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  h2 {
    font-family: "Archivo", system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .activity-subtitle {
    margin-top: 2px;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.85rem;
    color: var(--muted);
    border: 1px solid var(--border);
    background: var(--surface-elevated);
    padding: 6px 12px;
    border-radius: 999px;
    transition: color 180ms ease, border-color 180ms ease;
    white-space: nowrap;
  }

  .profile-link:hover {
    color: var(--fg);
    border-color: var(--accent);
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
  }

  .stat {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-value {
    font-family: "Archivo", system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .graph-scroll {
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-color: var(--border) transparent;
    scrollbar-width: thin;
  }

  .graph-inner {
    width: max-content;
  }

  .months-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .day-spacer {
    width: 26px;
    flex-shrink: 0;
  }

  .months-track {
    display: grid;
    grid-template-columns: repeat(var(--weeks), 11px);
    gap: 3px;
    font-size: 0.72rem;
    line-height: 1.1;
    color: var(--subtle);
  }

  .month-label {
    width: 0;
    overflow: visible;
    white-space: nowrap;
  }

  .grid-body {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .day-labels {
    width: 26px;
    flex-shrink: 0;
    display: grid;
    grid-template-rows: repeat(7, 11px);
    gap: 3px;
    font-size: 0.68rem;
    line-height: 11px;
    color: var(--subtle);
  }

  .weeks-grid {
    display: flex;
    gap: 3px;
  }

  .week-col {
    display: grid;
    grid-template-rows: repeat(7, 11px);
    gap: 3px;
    flex-shrink: 0;
  }

  .cell {
    width: 11px;
    height: 11px;
    border-radius: 2.5px;
    display: block;
    transition: transform 100ms ease, outline-color 100ms ease;
  }

  .cell.empty {
    background: transparent;
    pointer-events: none;
  }

  .cell[data-level="0"] {
    background: #16161b;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .cell[data-level="1"] {
    background: #172554;
  }

  .cell[data-level="2"] {
    background: #1d4ed8;
  }

  .cell[data-level="3"] {
    background: #2563eb;
  }

  .cell[data-level="4"] {
    background: #60a5fa;
    box-shadow: 0 0 6px rgba(96, 165, 250, 0.35);
  }

  .weeks-grid .cell:not(.empty):hover,
  .weeks-grid .cell:not(.empty):focus-visible {
    transform: scale(1.25);
    outline: 1.5px solid var(--fg);
    outline-offset: 1px;
    position: relative;
    z-index: 2;
  }

  .graph-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .inspect-readout {
    font-size: 0.8rem;
    color: var(--muted);
    min-height: 1.2em;
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: var(--subtle);
  }

  .legend span:first-child {
    margin-right: 4px;
  }

  .legend span:last-child {
    margin-left: 4px;
  }

  @media (max-width: 640px) {
    .activity-card {
      padding: 18px;
    }

    .stats-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cell,
    .profile-link {
      transition: none;
    }
  }
</style>
