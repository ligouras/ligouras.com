---
import type { ContributionSummary } from "../lib/github-contributions";

interface Props {
  data: ContributionSummary;
}

const { data } = Astro.props;
const weekCount = data.weeks.length;

// The heatmap is display-only: one text alternative for the whole picture,
// no per-day focus stops (the stats row above carries the numbers).
const heatmapLabel =
  data.source === "fallback"
    ? "GitHub contribution heatmap (unavailable)"
    : `GitHub contribution heatmap: ${data.totalContributions.toLocaleString("en-US")} contributions in the last year`;
---

<section class="activity-card" aria-labelledby="activity-heading">
  <div class="activity-header">
    <h2 id="activity-heading">GitHub Activity</h2>
    <a
      class="profile-link"
      href={`https://github.com/${data.username}`}
      target="_blank"
      rel="me noopener"
    >
      @{data.username}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
  <p class="activity-subtitle">
    {
      data.source === "fallback"
        ? "Activity feed unavailable offline"
        : `${data.totalContributions.toLocaleString("en-US")} contributions in the last year`
    }
  </p>

  <div class="graph-scroll" role="img" aria-label={heatmapLabel}>
    <div class="graph-inner" style={`--weeks: ${weekCount};`}>
      <div class="months-row">
        <div class="day-spacer"></div>
        <div class="months-track">
          {
            data.monthLabels.map((m) => (
              <span class="month-label" style={`grid-column-start: ${m.weekIndex + 1};`}>
                {m.label}
              </span>
            ))
          }
        </div>
      </div>

      <div class="grid-body">
        <div class="day-labels">
          <span></span>
          <span>Mon</span>
          <span></span>
          <span>Wed</span>
          <span></span>
          <span>Fri</span>
          <span></span>
        </div>

        <div class="weeks-grid">
          {
            data.weeks.map((week) => (
              <div class="week-col">
                {week.days.map((day) =>
                  day ? (
                    <span class="cell" data-level={day.level} />
                  ) : (
                    <span class="cell empty" />
                  ),
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="graph-footer">
    <div class="legend" aria-hidden="true">
      <span>Less</span>
      <span class="cell" data-level="0"></span>
      <span class="cell" data-level="1"></span>
      <span class="cell" data-level="2"></span>
      <span class="cell" data-level="3"></span>
      <span class="cell" data-level="4"></span>
      <span>More</span>
    </div>
  </div>
</section>

<style>
  .activity-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
  }

  .activity-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  h2 {
    font-family: "Archivo", system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .activity-subtitle {
    margin: 2px 0 20px;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.85rem;
    color: var(--muted);
    border: 1px solid var(--border);
    background: var(--surface-elevated);
    padding: 6px 12px;
    border-radius: 999px;
    transition: color 180ms ease, border-color 180ms ease;
    white-space: nowrap;
  }

  .profile-link:hover {
    color: var(--fg);
    border-color: var(--accent);
  }

  /* rtl on the scroller makes narrow screens open on the most recent weeks;
     the content itself is flipped back to ltr. */
  .graph-scroll {
    direction: rtl;
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-color: var(--border) transparent;
    scrollbar-width: thin;
  }

  .graph-inner {
    direction: ltr;
    width: max-content;
    margin-right: auto; /* left-aligned when it fits */
  }

  .months-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .day-spacer {
    width: 26px;
    flex-shrink: 0;
  }

  .months-track {
    display: grid;
    grid-template-columns: repeat(var(--weeks), 11px);
    gap: 3px;
    font-size: 0.75rem;
    line-height: 1.1;
    color: var(--subtle);
  }

  .month-label {
    width: 0;
    overflow: visible;
    white-space: nowrap;
  }

  .grid-body {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .day-labels {
    width: 26px;
    flex-shrink: 0;
    display: grid;
    grid-template-rows: repeat(7, 11px);
    gap: 3px;
    font-size: 0.68rem;
    line-height: 11px;
    color: var(--subtle);
  }

  .weeks-grid {
    display: flex;
    gap: 3px;
  }

  .week-col {
    display: grid;
    grid-template-rows: repeat(7, 11px);
    gap: 3px;
    flex-shrink: 0;
  }

  .cell {
    width: 11px;
    height: 11px;
    border-radius: 2.5px;
    display: block;
  }

  .cell.empty {
    background: transparent;
  }

  .cell[data-level="0"] {
    background: #16161b;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .cell[data-level="1"] {
    background: #172554;
  }

  .cell[data-level="2"] {
    background: #1d4ed8;
  }

  .cell[data-level="3"] {
    background: #2563eb;
  }

  .cell[data-level="4"] {
    background: #60a5fa;
    box-shadow: 0 0 6px rgba(96, 165, 250, 0.35);
  }

  .graph-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 12px;
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    color: var(--subtle);
  }

  .legend span:first-child {
    margin-right: 4px;
  }

  .legend span:last-child {
    margin-left: 4px;
  }

  @media (max-width: 640px) {
    .activity-card {
      padding: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-link {
      transition: none;
    }
  }
</style>
