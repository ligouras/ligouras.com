---
// Static font weights (not variable fonts) so Chrome embeds real TrueType
// fonts in the PDF instead of Type 3 glyphs, which some ATS parsers mangle.
import "@fontsource/archivo/700.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import { loadProfile } from "../../lib/profile";

const profile = loadProfile();

const focusAreas = profile.headline
  .split("|")
  .map((s) => s.trim())
  .filter(Boolean);

const pageTitle = `${profile.name} — Curriculum Vitae`;
const description = `Curriculum Vitae of ${profile.name}, ${profile.title} (${focusAreas.join(", ")}).`;
const pageUrl = new URL("/cv/", Astro.site ?? profile.website).href;
const ogImage = new URL("/og.jpg", Astro.site ?? profile.website).href;

const prettyUrl = (url: string) =>
  url.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");

// One row per role: the sub-roles when a company lists them, otherwise the
// single role with the company's overall period.
const experience = profile.experience.map((exp) => ({
  ...exp,
  roles:
    exp.subroles.length > 0
      ? exp.subroles
      : [{ title: exp.role, period: exp.period }],
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={pageUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>L</text></svg>"
    />
  </head>
  <body>
    <nav class="toolbar no-print" aria-label="CV actions">
      <a class="toolbar-link" href="/">← ligouras.com</a>
      <div class="toolbar-actions">
        <a class="toolbar-btn" href="/cv.pdf" download="Spyros-Ligouras-CV.pdf">Download PDF</a>
        <button class="toolbar-btn toolbar-btn-primary" type="button" onclick="window.print()">
          Print
        </button>
      </div>
    </nav>

    <main class="sheet">
      <header class="cv-header">
        <div class="identity">
          <h1>{profile.name}</h1>
          <p class="title">{profile.title}</p>
          <p class="focus">{focusAreas.join(" · ")}</p>
        </div>
        <ul class="contact-list">
          {profile.email && (
            <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          )}
          <li>{profile.location}</li>
          <li><a href={profile.website}>{prettyUrl(profile.website)}</a></li>
          <li><a href={profile.github}>{prettyUrl(profile.github)}</a></li>
          <li><a href={profile.linkedin}>{prettyUrl(profile.linkedin)}</a></li>
        </ul>
      </header>

      <section class="cv-section" aria-labelledby="profile-h">
        <h2 id="profile-h">Profile</h2>
        <p class="summary">{profile.summary}</p>
      </section>

      <section class="cv-section" aria-labelledby="experience-h">
        <h2 id="experience-h">Experience</h2>
        <div class="entries">
          {
            experience.map((exp) => (
              <article class="entry">
                <div class="entry-row">
                  <h3 class="org">{exp.company}</h3>
                  <span class="meta">{exp.location}</span>
                </div>
                {exp.roles.map((r) => (
                  <div class="entry-row">
                    <span class="role">{r.title}</span>
                    <span class="meta">{r.period}</span>
                  </div>
                ))}
                {exp.bullets.length > 0 && (
                  <ul class="bullets">
                    {exp.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="cv-section" aria-labelledby="education-h">
        <h2 id="education-h">Education</h2>
        <div class="entries">
          {
            profile.education.map((edu) => (
              <article class="entry">
                <div class="entry-row">
                  <h3 class="org">{edu.degree}</h3>
                  <span class="meta">{edu.period}</span>
                </div>
                <p class="role">{edu.institution}</p>
                {edu.notes && <p class="entry-desc">{edu.notes}</p>}
              </article>
            ))
          }
        </div>
      </section>

      <section class="cv-section" aria-labelledby="pubs-h">
        <h2 id="pubs-h">Publications &amp; Press</h2>
        <ul class="bullets">
          {
            profile.publications.map((pub) => (
              <li>
                {pub.url ? (
                  <a class="strong-link" href={pub.url}>{pub.title}</a>
                ) : (
                  <strong>{pub.title}</strong>
                )}{" "}
                — {pub.venue}
                {pub.year ? ` (${pub.year})` : ""}
              </li>
            ))
          }
          {
            profile.press.map((item) => (
              <li>
                <a class="strong-link" href={item.url}>{item.title}</a> — {item.outlet} ({item.date})
              </li>
            ))
          }
        </ul>
      </section>

      <section class="cv-section grid-two">
        <div>
          <h2>Skills</h2>
          <ul class="bullets">
            {
              profile.skills.map((group) => (
                <li>
                  <strong>{group.category}:</strong> {group.items.join(", ")}
                </li>
              ))
            }
          </ul>
          <h2 class="mt">Languages</h2>
          <ul class="bullets">
            {profile.languages.map((lang) => <li>{lang}</li>)}
          </ul>
        </div>
        <div>
          <h2>Certifications</h2>
          <ul class="bullets">
            {profile.certifications.map((cert) => <li>{cert}</li>)}
          </ul>
          <h2 class="mt">Honors &amp; Awards</h2>
          <ul class="bullets">
            {profile.honors.map((honor) => <li>{honor}</li>)}
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  @page {
    size: A4;
    margin: 13mm 15mm;
  }

  :root {
    --ink: #0f172a;
    --ink-muted: #475569;
    --ink-subtle: #64748b;
    --accent: #1d4ed8;
    --line: #cbd5e1;
    --paper: #ffffff;
    --bg: #f1f5f9;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: "Space Grotesk", -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 9.5pt;
    line-height: 1.42;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 3px;
  }

  /* ---------- Screen chrome ---------- */

  .toolbar {
    max-width: 210mm;
    margin: 18px auto 0;
    padding: 0 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .toolbar-link {
    font-size: 0.9rem;
    color: var(--ink-muted);
    font-weight: 500;
  }

  .toolbar-actions {
    display: flex;
    gap: 8px;
  }

  .toolbar-btn {
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    border-radius: 7px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .toolbar-btn:hover {
    text-decoration: none;
    border-color: var(--ink-subtle);
  }

  .toolbar-btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .toolbar-btn-primary:hover {
    background: #1e40af;
    border-color: #1e40af;
  }

  .sheet {
    width: 210mm;
    max-width: 100%;
    margin: 14px auto 36px;
    background: var(--paper);
    padding: 15mm 16mm;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    border-radius: 4px;
  }

  /* ---------- Header ---------- */

  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 12px;
  }

  h1 {
    font-family: "Archivo", sans-serif;
    font-size: 22pt;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .title {
    font-size: 11pt;
    font-weight: 600;
    color: var(--ink);
    margin-top: 3px;
  }

  .focus {
    font-size: 9pt;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .contact-list {
    list-style: none;
    text-align: right;
    font-size: 8.5pt;
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .contact-list a {
    color: var(--ink-muted);
  }

  /* ---------- Sections ---------- */

  .cv-section {
    margin-bottom: 12px;
  }

  .cv-section h2 {
    font-family: "Archivo", sans-serif;
    font-size: 9.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--accent);
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
    margin-bottom: 7px;
    break-after: avoid;
  }

  .cv-section h2.mt {
    margin-top: 9px;
  }

  .summary {
    font-size: 9.2pt;
  }

  .entries {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .entry {
    break-inside: avoid;
  }

  .entry-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 12px;
    flex-wrap: wrap;
  }

  .org {
    font-family: inherit;
    font-size: 9.5pt;
    font-weight: 600;
    color: var(--ink);
  }

  .role {
    font-size: 9pt;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .meta {
    font-size: 8.2pt;
    color: var(--ink-subtle);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .entry-desc {
    font-size: 8.8pt;
    color: var(--ink-muted);
    margin-top: 2px;
  }

  .bullets {
    margin-top: 3px;
    padding-left: 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .bullets li {
    font-size: 8.8pt;
    color: var(--ink-muted);
  }

  .bullets li::marker {
    color: var(--ink-subtle);
  }

  .bullets li strong {
    color: var(--ink);
    font-weight: 600;
  }

  .strong-link {
    font-weight: 600;
  }

  .grid-two {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 18px;
    break-inside: avoid;
  }

  /* ---------- Print ---------- */

  @media print {
    body {
      background: #ffffff;
    }

    .no-print {
      display: none !important;
    }

    .sheet {
      width: auto;
      margin: 0;
      padding: 0;
      box-shadow: none;
      border-radius: 0;
    }

    p,
    li {
      orphans: 2;
      widows: 2;
    }
  }

  /* ---------- Small screens ---------- */

  @media (max-width: 720px) {
    body {
      font-size: 10pt;
    }

    .toolbar {
      padding: 0 12px;
    }

    .sheet {
      padding: 22px 18px;
      margin: 10px 0 24px;
      border-radius: 0;
    }

    .cv-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .contact-list {
      text-align: left;
    }

    .grid-two {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
