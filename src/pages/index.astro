---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import portrait from "../assets/portrait.webp";
import ContributionGraph from "../components/ContributionGraph.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { loadProfile } from "../lib/profile";
import { getGitHubContributions } from "../lib/github-contributions";

const profile = loadProfile();
const contributions = await getGitHubContributions(profile.githubUsername);
// Ventures already have their own cards, so the homepage timeline skips any
// current role whose company names a venture's domain (the CV keeps them all).
const ventureHosts = profile.ventures
  .map((v) => (v.url ? new URL(v.url).hostname.replace(/^www\./, "") : ""))
  .filter(Boolean);
// Projects that stay on the CV but are too granular for the homepage.
const homepageHiddenProjects = new Set([
  "https://grnet.gr/business-directory/webuild/",
  "https://github.com/webuild-consortium/webuild-github-policies",
]);
const currentExperience = profile.experience
  .filter(
    (exp) =>
      /present/i.test(exp.period) &&
      !ventureHosts.some((host) => exp.company.includes(host)),
  )
  .map((exp) => ({
    ...exp,
    projects: exp.projects.filter((p) => !homepageHiddenProjects.has(p.url)),
  }));
const currentYear = new Date().getFullYear();

const summaryHtml = profile.summary
  .replace(/&/g, "&amp;")
  .replace(/</g, "&lt;")
  .replace(/>/g, "&gt;")
  .replace(
    "LL Cloud (devop.sh)",
    '<a class="inline-link" href="https://devop.sh/" target="_blank" rel="noopener">LL Cloud</a>',
  )
  .replace(
    "LinkSentry (linksentry.io)",
    '<a class="inline-link" href="https://linksentry.io/" target="_blank" rel="noopener">LinkSentry</a>',
  )
  .replace(
    /\bGRNET\b/,
    '<a class="inline-link" href="https://grnet.gr/en/" target="_blank" rel="noopener">GRNET</a>',
  );

// Homepage shows "City, Country"; the CV keeps the full location string.
const city = profile.location.replace(/\s+Metropolitan Area/i, "").trim();

// Lucide-style 24px stroke icons for the focus-area chips.
const focusIcons: Record<string, string> = {
  devops:
    '<path d="M12 12c-2-2.67-4-4-6-4a4 4 0 1 0 0 8c2 0 4-1.33 6-4Zm0 0c2 2.67 4 4 6 4a4 4 0 0 0 0-8c-2 0-4 1.33-6 4Z"/>',
  cloudops: '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>',
  secops:
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
};
const pinIcon =
  '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>';

const focusAreas = profile.headline
  .split("|")
  .map((label) => label.trim())
  .filter(Boolean)
  .map((label) => ({ label, icon: focusIcons[label.toLowerCase()] }));

const socials = [
  {
    label: "GitHub",
    handle: `@${profile.githubUsername}`,
    href: profile.github,
    icon: "github" as const,
  },
  {
    label: "LinkedIn",
    handle: "spyrosligouras",
    href: profile.linkedin,
    icon: "linkedin" as const,
  },
  {
    label: "X",
    handle: `@${profile.githubUsername}`,
    href: profile.x,
    icon: "x" as const,
  },
];
---

<BaseLayout
  title={`${profile.name} — ${profile.headline}`}
  description={profile.summary}
  url={profile.website}
>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="topbar" id="top">
    <div class="topbar-inner">
      <a class="brand" href="#top">
        {profile.brand}<span class="accent">.</span>
      </a>
      <nav class="topnav" aria-label="Main">
        <a class="nav-link" href="#ventures">Ventures</a>
        <a class="nav-link" href="#experience">Experience</a>
        <a class="nav-link" href="#activity">Activity</a>
        <a class="nav-link" href="/cv/">CV</a>
      </nav>
      <div class="top-actions">
        <a
          class="icon-link"
          href={profile.github}
          aria-label="GitHub"
          rel="me noopener"
          target="_blank"
        >
          <SocialIcons icon="github" />
        </a>
        <a
          class="nav-pill"
          href="/cv.pdf"
          download="Spyros-Ligouras-CV.pdf"
        >
          CV (PDF)
        </a>
      </div>
    </div>
  </header>

  <main class="container" id="main" tabindex="-1">
    <header class="hero">
      <div class="hero-portrait">
        <Image
          src={portrait}
          alt={`Portrait of ${profile.name}`}
          width={200}
          height={200}
          widths={[72, 144, 200, 216, 400, 600]}
          sizes="(max-width: 600px) 72px, 200px"
          format="webp"
          quality={92}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <div class="hero-text">
        <p class="wordmark" aria-hidden="true">
          {profile.brand}<span class="accent">.</span>
        </p>

        <div class="lead">
          <h1 class="lead-name">{profile.name}</h1>
          <span class="lead-location">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={pinIcon}
            />
            {city}
          </span>
        </div>

        <ul class="focus-list" aria-label="Focus areas">
          {
            focusAreas.map((area) => (
              <li class="focus-chip">
                {area.icon && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={area.icon}
                  />
                )}
                {area.label}
              </li>
            ))
          }
        </ul>
        <p class="bio" set:html={summaryHtml} />

        <div class="hero-actions">
          <a class="btn btn-primary" href={`mailto:${profile.email}`}>
            Get in touch
          </a>
          <a class="btn btn-secondary" href="/cv.pdf" download="Spyros-Ligouras-CV.pdf">
            Download CV (PDF)
          </a>
        </div>
      </div>
    </header>

    <section id="ventures" aria-labelledby="ventures-heading">
      <div class="section-head">
        <h2 id="ventures-heading">Ventures</h2>
      </div>
      <div class="ventures-grid">
        {
          profile.ventures.map((v) => (
            <article class="venture-card">
              <div class="venture-top">
                <div>
                  <h3>
                    <a href={v.url} target="_blank" rel="noopener">
                      {v.name} <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                  <p class="venture-role">
                    {v.role} · {v.period}
                  </p>
                </div>
              </div>
              <p class="venture-summary">{v.summary}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section id="experience" aria-labelledby="experience-heading">
      <div class="section-head">
        <h2 id="experience-heading">Experience</h2>
        <a class="section-link" href="/cv/">Full CV →</a>
      </div>
      <div class="timeline">
        {
          currentExperience.map((exp) => (
            <article class="timeline-item">
              <div class="timeline-meta">
                <span class="timeline-period">{exp.period}</span>
                <span class="timeline-location">{exp.location}</span>
              </div>
              <div class="timeline-body">
                <h3>{exp.company}</h3>
                {exp.subroles.length > 0 ? (
                  <ul class="subroles">
                    {exp.subroles.map((sr) => (
                      <li>
                        <span class="subrole-title">{sr.title}</span>
                        <span class="subrole-period">{sr.period}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="timeline-role">{exp.role}</p>
                )}
                {exp.bullets.length > 0 && (
                  <ul class="bullets">
                    {exp.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                )}
                {exp.projects.length > 0 && (
                  <div class="exp-projects">
                    <span class="exp-projects-label">Recent projects</span>
                    <ul class="exp-projects-list">
                      {exp.projects.map((p) => (
                        <li>
                          <a href={p.url} target="_blank" rel="noopener">
                            {p.title} <span aria-hidden="true">↗</span>
                          </a>
                          <span>{p.summary}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <div id="activity">
      <ContributionGraph data={contributions} />
    </div>

    <section class="two-col" aria-label="Research, Education and Press">
      <div class="panel">
        <h2>Publications &amp; Press</h2>
        <ul class="ref-list">
          {
            profile.publications
              .filter((pub) => /usenix/i.test(pub.venue))
              .map((pub) => (
              <li>
                {pub.url ? (
                  <a href={pub.url} target="_blank" rel="noopener">
                    {pub.title} ↗
                  </a>
                ) : (
                  <span>{pub.title}</span>
                )}
                <small>
                  {pub.venue}
                  {pub.year ? ` (${pub.year})` : ""}
                </small>
              </li>
            ))
          }
          {
            profile.press.map((item) => (
              <li>
                <a href={item.url} target="_blank" rel="noopener">
                  {item.title} ↗
                </a>
                <small>
                  {item.outlet} · {item.date}
                </small>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="panel">
        <h2>Education &amp; Credentials</h2>
        <ul class="ref-list">
          {
            profile.education.map((edu) => (
              <li>
                <span>{edu.degree}</span>
                <small>
                  {edu.institution} · {edu.period}
                </small>
              </li>
            ))
          }
          {
            profile.certifications.slice(0, 1).map((cert) => (
              <li>
                <span>{cert}</span>
                <small>Certification</small>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section aria-label="Social links">
      <nav class="social-grid" aria-label="Social profiles">
        {
          socials.map((social) => (
            <a
              class="social-card"
              href={social.href}
              rel="me noopener"
              target="_blank"
            >
              <span class="social-icon">
                <SocialIcons icon={social.icon} />
              </span>
              <span class="social-meta">
                <span class="social-label">{social.label}</span>
                <span class="social-handle">{social.handle}</span>
              </span>
              <span class="social-arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          ))
        }
      </nav>
    </section>

    <footer class="footer">
      <span>&copy; {currentYear} {profile.name}</span>
      <span class="footer-links">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <span aria-hidden="true">·</span>
        <a href="/cv/">CV</a>
      </span>
    </footer>
  </main>
</BaseLayout>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(9, 9, 11, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .topbar-inner {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .brand {
    font-family: "Archivo", system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .brand .accent {
    color: var(--accent-hover);
  }

  .topnav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .nav-link {
    font-size: 0.86rem;
    color: var(--muted);
    transition: color 160ms ease;
  }

  .nav-link:hover {
    color: var(--fg);
  }

  .top-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .icon-link {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .icon-link:hover {
    color: var(--fg);
    border-color: var(--accent);
  }

  .icon-link :global(svg) {
    width: 16px;
    height: 16px;
  }

  .nav-pill {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 5px 12px;
    border-radius: 8px;
    transition: border-color 160ms ease, background-color 160ms ease;
    white-space: nowrap;
  }

  .nav-pill:hover {
    border-color: var(--accent);
    background: var(--surface-elevated);
  }

  /* Keep anchor jumps and keyboard-focused elements clear of the sticky bar. */
  :global(html) {
    scroll-padding-top: 72px;
  }

  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 30;
    padding: 8px 14px;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 500;
    transform: translateY(-150%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  .container {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(32px, 6vw, 56px) 24px 56px;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "text portrait";
    align-items: start;
    gap: 32px;
  }

  .hero-text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .hero-portrait {
    grid-area: portrait;
    margin-top: 6px;
    border-radius: 50%;
    padding: 4px;
    background:
      linear-gradient(var(--bg), var(--bg)) padding-box,
      linear-gradient(145deg, var(--accent-hover), var(--border) 55%) border-box;
    border: 1px solid transparent;
    box-shadow: 0 0 40px var(--accent-glow);
  }

  .hero-portrait :global(img) {
    display: block;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface-elevated);
  }

  .wordmark {
    font-family: "Archivo", system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2.6rem, 8vw, 4rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: 14px;
    text-shadow: 0 0 28px rgba(250, 250, 250, 0.1);
  }

  .wordmark .accent {
    color: var(--accent);
  }

  .lead {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 14px;
    row-gap: 2px;
    font-size: clamp(1.05rem, 2.6vw, 1.2rem);
    color: var(--fg);
    margin-bottom: 16px;
  }

  .lead-name {
    font: inherit;
    font-weight: 500;
    line-height: 1.6;
  }

  .lead-location {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.86rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .lead-location svg {
    width: 14px;
    height: 14px;
    color: var(--subtle);
    flex-shrink: 0;
  }

  .focus-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .focus-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 11px 5px 9px;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .focus-chip svg {
    width: 15px;
    height: 15px;
    color: var(--accent-hover);
    flex-shrink: 0;
  }

  .bio {
    font-size: 0.98rem;
    color: var(--muted);
    max-width: 64ch;
    margin-bottom: 22px;
  }

  .bio :global(.inline-link) {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(37, 99, 235, 0.55);
    text-underline-offset: 3px;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .bio :global(.inline-link:hover) {
    color: var(--accent-hover);
    text-decoration-color: var(--accent-hover);
  }

  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 16px;
    border-radius: 9px;
    font-size: 0.88rem;
    font-weight: 500;
    border: 1px solid var(--border);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: var(--surface);
    color: var(--fg);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    background: var(--surface-elevated);
    transform: translateY(-1px);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .section-head h2,
  .panel h2 {
    font-family: "Archivo", system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .section-link {
    font-size: 0.85rem;
    color: var(--muted);
    transition: color 160ms ease;
  }

  .section-link:hover {
    color: var(--accent-hover);
  }

  .ventures-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .venture-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .venture-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .venture-card h3 {
    font-family: "Archivo", system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .venture-card h3 a:hover {
    color: var(--accent-hover);
  }

  .venture-role {
    font-size: 0.82rem;
    color: var(--muted);
    margin-top: 2px;
  }

  .venture-summary {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 20px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
  }

  .timeline-item:last-child {
    border-bottom: none;
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .timeline-period {
    font-size: 0.82rem;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .timeline-location {
    font-size: 0.8125rem;
    color: var(--subtle);
  }

  .timeline-body h3 {
    font-family: "Archivo", system-ui, sans-serif;
    font-size: 0.96rem;
    font-weight: 600;
    color: var(--fg);
  }

  .timeline-role {
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--fg-secondary);
    margin-top: 2px;
  }

  .subroles {
    list-style: none;
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .subroles li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  .subrole-title {
    font-weight: 500;
    color: var(--fg-secondary);
  }

  .subrole-period {
    color: var(--subtle);
    font-size: 0.8125rem;
  }

  .bullets {
    margin-top: 8px;
    padding-left: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bullets li {
    font-size: 0.86rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .exp-projects {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed var(--border);
  }

  .exp-projects-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--subtle);
    margin-bottom: 6px;
  }

  .exp-projects-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .exp-projects-list li {
    display: flex;
    flex-direction: column;
